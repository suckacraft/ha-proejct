---
import { site } from "../content/site";
import Icon from "./Icon.astro";
const { pricing } = site;
---

<section id="packages" class="border-t border-border/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <span
        class="font-display text-[11px] font-semibold uppercase tracking-[0.2em] text-primary"
        >Packages</span
      >
      <h2 class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight md:text-5xl">
        {pricing.heading}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-white/60">{pricing.intro}</p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {
        pricing.tiers.map((tier) => (
          <article
            class={`relative flex flex-col rounded-2xl border p-7 ${
              tier.featured
                ? "border-primary/50 bg-raised"
                : "border-border bg-surface"
            }`}
          >
            {tier.featured && (
              <span class="absolute right-6 top-7 rounded-full bg-primary px-3 py-1 font-display text-[9px] font-semibold uppercase tracking-[0.15em] text-white">
                Most popular
              </span>
            )}
            <h3 class="font-display text-2xl font-bold uppercase tracking-wide">{tier.name}</h3>
            <p class="mt-2 text-sm text-white/50">{tier.blurb}</p>
            <p class="mt-5 font-display text-3xl font-black">{tier.price}</p>
            <ul class="mt-6 flex flex-1 flex-col gap-3">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2.5 text-[15px] text-white/75">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={tier.cta.href}
              class={`mt-7 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-transform duration-150 active:scale-[0.97] ${
                tier.featured
                  ? "bg-primary text-white hover:brightness-110"
                  : "border border-border bg-raised text-white hover:border-primary/40"
              }`}
            >
              {tier.cta.label}
            </a>
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-center text-sm text-white/40">{pricing.note}</p>
  </div>
</section>
