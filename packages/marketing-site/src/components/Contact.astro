---
import { site } from "../content/site";
import LeadCapture from "./react/LeadCapture.tsx";
import Icon from "./Icon.astro";
const { contact, brand, leadCapture } = site;
---

<section id="contact" class="border-t border-border/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 rounded-3xl border border-border bg-surface p-7 md:grid-cols-2 md:p-10">
      <!-- Left: pitch -->
      <div class="flex flex-col">
        <span
          class="font-display text-[11px] font-semibold uppercase tracking-[0.2em] text-primary"
          >Get started</span
        >
        <h2 class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight md:text-5xl">
          {contact.heading}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-white/60">{contact.body}</p>

        <ul class="mt-8 flex flex-col gap-4">
          <li class="flex items-center gap-3 text-white/75">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-raised text-primary">
              <Icon name="check" class="h-5 w-5" />
            </span>
            Free, no-pressure consult
          </li>
          <li class="flex items-center gap-3 text-white/75">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-raised text-primary">
              <Icon name="scenes" class="h-5 w-5" />
            </span>
            A design tailored to your home
          </li>
          <li class="flex items-center gap-3 text-white/75">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-raised text-primary">
              <Icon name="shield" class="h-5 w-5" />
            </span>
            Done for you — and supported after
          </li>
        </ul>

        {
          brand.email && (
            <p class="mt-auto pt-8 text-sm text-white/40">
              Prefer email?{" "}
              <a href={`mailto:${brand.email}`} class="text-white/70 underline-offset-4 hover:underline">
                {brand.email}
              </a>
            </p>
          )
        }
      </div>

      <!-- Right: the form island -->
      <div class="rounded-2xl border border-border bg-raised p-6 md:p-7">
        <LeadCapture
          endpoint={contact.endpoint}
          successUrl={contact.success}
          fields={leadCapture.fields}
          submitLabel={leadCapture.submitLabel}
          client:visible
        />
      </div>
    </div>
  </div>
</section>
