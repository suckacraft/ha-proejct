---
import { site } from "../content/site";
const { faqs } = site;
---

<section id="faq" class="border-t border-border/60 py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-5">
    <div class="text-center">
      <span
        class="font-display text-[11px] font-semibold uppercase tracking-[0.2em] text-primary"
        >FAQ</span
      >
      <h2 class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight md:text-5xl">
        {faqs.heading}
      </h2>
    </div>

    <div class="mt-10 flex flex-col gap-3">
      {
        faqs.items.map((item) => (
          <details class="group rounded-2xl border border-border bg-surface px-6 open:border-primary/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-lg font-bold uppercase tracking-wide [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-border text-white/60 transition-transform duration-150 group-open:rotate-45 group-open:text-primary">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="pb-5 leading-relaxed text-white/65">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
