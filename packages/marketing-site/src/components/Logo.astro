---
// SmartBoyz wordmark. Display font, single accent dot — depth via type, not color.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<a
  href="/"
  class={`group inline-flex items-baseline gap-1 font-display text-2xl font-extrabold uppercase tracking-tight text-white ${className}`}
  aria-label="SmartBoyz home"
>
  <span class="inline-flex h-7 w-7 items-center justify-center self-center rounded-lg bg-primary">
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5.5 10v9.5h13V10" />
    </svg>
  </span>
  <span>Smart<span class="text-white/60 transition-colors group-hover:text-white">Boyz</span></span>
</a>
