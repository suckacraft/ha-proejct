# Ensure shell scripts always have LF line endings on checkout.
# CRLF in .sh files causes bash to fail with $'\r': command not found errors.
*.sh    text eol=lf

# Keep all other text files normalised to LF in the repo; Windows tools get
# CRLF on checkout via core.autocrlf, but the repo itself stays clean.
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf
*.conf  text eol=lf

# Binary -- never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff  binary
*.woff2 binary
