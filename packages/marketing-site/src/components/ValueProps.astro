---
import { site } from "../content/site";
import Icon from "./Icon.astro";
const { valueProps } = site;
---

<section id="features" class="border-t border-border/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <span
        class="font-display text-[11px] font-semibold uppercase tracking-[0.2em] text-primary"
        >What you get</span
      >
      <h2 class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight md:text-5xl">
        {valueProps.heading}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-white/60">{valueProps.intro}</p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        valueProps.items.map((item) => (
          <article class="group rounded-2xl border border-border bg-surface p-6 transition-colors duration-150 hover:border-primary/40">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-border bg-raised text-primary transition-colors group-hover:border-primary/40">
              <Icon name={item.icon} class="h-6 w-6" />
            </div>
            <h3 class="mt-5 font-display text-xl font-bold uppercase tracking-wide">
              {item.title}
            </h3>
            <p class="mt-2 text-[15px] leading-relaxed text-white/60">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
